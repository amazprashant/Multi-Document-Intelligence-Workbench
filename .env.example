# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/workbench.db

# LLM: leave ANTHROPIC_API_KEY empty to use the offline mock provider.
LLM_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Large-document handling
MAX_DOC_CHARS=200000
CHUNK_CHARS=8000
CHUNK_OVERLAP=300
LLM_CONCURRENCY=3
EXTRACT_TIMEOUT_MS=20000
